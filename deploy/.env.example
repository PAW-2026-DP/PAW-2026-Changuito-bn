# Copiar a /opt/changuito/.env EN LA VM y completar con valores reales.
# Este archivo nunca se versiona con credenciales de verdad.

# Repositorio de Artifact Registry, sin el nombre de la imagen.
# Formato: <region>-docker.pkg.dev/<project-id>/<repo>
IMAGE_REPO=southamerica-east1-docker.pkg.dev/CAMBIAR-project-id/changuito

# Tag a correr. El deploy lo pisa con sha-<commit>; el valor de aca es el
# fallback y el que se edita a mano para hacer rollback.
IMAGE_TAG=dev

DB_DATABASE=changuito
DB_USERNAME=changuito
DB_PASSWORD=CAMBIAR
DB_ROOT_PASSWORD=CAMBIAR
