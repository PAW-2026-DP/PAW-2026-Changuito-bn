APP_ENV=dev
APP_PORT=8080

DB_HOST=db
DB_PORT=3306
DB_DATABASE=changuito
DB_USERNAME=changuito
DB_PASSWORD=changuito
DB_ROOT_PASSWORD=root

# Base separada para los tests de Integration (ConnectionFactory::forTests()).
# Se crea sola la primera vez que se levanta el contenedor `db` (ver
# docker/mariadb/init/). No se usa en producción.
DB_TEST_DATABASE=changuito_test

# Orígenes permitidos para CORS, separados por coma: los 3 frontends
# (cliente, backoffice, riders). Completar con la URL real de cada uno.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
